# Gmail SMTP works at no cost for personal testing with an App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-account@gmail.com
SMTP_PASSWORD=your-16-character-app-password
SMTP_FROM=LOP Planificador <your-account@gmail.com>

# Google OAuth 2.0 Web application credentials.
# Local development template: do not overwrite an existing .env or copy production secrets here.
# Public production requires a separate Google Cloud project/client and reviewed HTTPS domains.
# With NODE_ENV=production, Google/YouTube callbacks must use a public HTTPS host, not localhost.
# Configure production secrets in its own environment after reviewing docs/YOUTUBE-PRODUCCION.md.
# The production env loader preserves injected Google secrets; development keeps its local .env priority.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback
# Register this second callback URI on the same Google OAuth web client.
YOUTUBE_REDIRECT_URI=http://localhost:5173/api/connections/youtube/callback

# Facebook Pages and Instagram OAuth share this Meta app and encryption key.
# Keep the app secret and encryption key private.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:5173/api/connections/facebook/callback
# Optional; defaults to the origin of FACEBOOK_REDIRECT_URI with this callback path.
INSTAGRAM_REDIRECT_URI=http://localhost:5173/api/connections/instagram/callback
META_GRAPH_API_VERSION=
SOCIAL_TOKEN_ENCRYPTION_KEY=

# TikTok profile connection (Login Kit for Web). Use the existing TikTok app.
# HTTPS callback must be registered exactly in the TikTok developer portal.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=

# Optional comma-separated allowed web origins.
# LOP_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
